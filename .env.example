# Runtime environment
APP_ENV=development
LOG_LEVEL=INFO
ADK_BACKEND=google_adk
ADK_MODEL=gemini-2.5-pro
ADK_TIMEOUT_SECONDS=30
ENABLE_LIVE_LISTING_FETCH=false
ENABLE_BROWSER_LISTING_FETCH=false
HTTP_TIMEOUT_SECONDS=20
BROWSER_FETCH_TIMEOUT_SECONDS=45
BROWSER_LISTING_FETCH_COMMAND=python3 scripts/fetch_rendered_listing.py {url}

# Provider configuration
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Output configuration
REPORT_OUTPUT_DIR=./output
